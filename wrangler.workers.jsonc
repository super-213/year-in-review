{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Set this to your existing Cloudflare Worker name before deploying.
  "name": "year-in-review",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/demo/*"]
  },
  "r2_buckets": [{ "binding": "DEMOS", "bucket_name": "year-in-review-demos" }]
}
